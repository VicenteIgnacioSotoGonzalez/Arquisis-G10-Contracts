{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnergyShark Protocol v2 - Distance Table",
  "allOf": [
    {
      "$comment": "Formato productivo informado: sender central, cityId null y cycleId opcional. La excepción es local porque common.centralEnvelope prohíbe incluso cityId null.",
      "type": "object",
      "required": [
        "idpk",
        "msgId",
        "type",
        "timestamp",
        "sender"
      ],
      "properties": {
        "idpk": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "msgId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "timestamp": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "cycleId": {
          "$ref": "common.schema.json#/$defs/cycleId"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "data"
      ],
      "properties": {
        "type": {
          "const": "distance-table"
        },
        "cityId": {
          "type": "null"
        },
        "sender": {
          "const": "central"
        },
        "data": {
          "type": "object",
          "required": [
            "distances"
          ],
          "properties": {
            "distances": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "distance",
                  "transportCost",
                  "enabled"
                ],
                "properties": {
                  "distance": {
                    "type": "number"
                  },
                  "transportCost": {
                    "type": "number"
                  },
                  "enabled": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
