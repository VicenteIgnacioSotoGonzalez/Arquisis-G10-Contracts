{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnergyShark Protocol v2 - Request",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/cityEnvelope"
    },
    {
      "type": "object",
      "required": [
        "data"
      ],
      "properties": {
        "type": {
          "const": "request"
        },
        "data": {
          "type": "object",
          "required": [
            "ask"
          ],
          "properties": {
            "ask": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "not": {
        "required": [
          "cycleId"
        ]
      }
    }
  ]
}
